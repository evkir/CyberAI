# LLM / API keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PHANTOM_GRID_KEY=your-grid-key
NVD_API_KEY=

# LLM selection
CYBERAI_LLM_PROVIDER=openai
CYBERAI_MODEL=gpt-4o

# Feature flags (default off; set to 1/true/yes/on to enable)
CYBERAI_USE_BEHAVIORAL=0
CYBERAI_USE_PORT_FINGERPRINT=0
CYBERAI_USE_NUCLEI=0
CYBERAI_USE_JUDGE=0
CYBERAI_ENABLE_REPLAN=0
CYBERAI_USE_EXPLOIT_MEMORY=0
CYBERAI_USE_LAB_DOGFOOD=0
CYBERAI_WEB_ENABLE_BENCH_TRIGGER=0
CYBERAI_AIR_GAPPED=0
CYBERAI_ENABLE_MODEL_ROUTING=0

# Numeric / path settings (optional)
CYBERAI_VERBOSE=0
CYBERAI_TIMEOUT=60
CYBERAI_MAX_AGENT_ITERATIONS=10
CYBERAI_MAX_COST_USD=0.0
CYBERAI_JUDGE_THRESHOLD=0.7
CYBERAI_JUDGE_MODEL=
CYBERAI_EXPLOIT_MEMORY_PATH=
CYBERAI_LAB_MACHINES_DIR=
CYBERAI_OUTPUT_DIR=reports/
